# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty for local development. The server then runs PGlite,
# which is PostgreSQL compiled to WebAssembly and executed in-process, storing
# its data in the directory below. Nothing to install and nothing to run.
#
# Set DATABASE_URL to a Postgres connection string to use a real server. On
# Vercel this is injected automatically when a Neon store is attached to the
# project, so it does not need to be set by hand there.
DATABASE_FILE=./data/auth-pg
DATABASE_URL=

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: at least 32 characters. The server refuses to boot
# without it when NODE_ENV=production. In development an ephemeral secret is
# generated at startup, which means tokens stop working across restarts — that
# is intentional, so a missing secret is obvious rather than silent.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=secure-user-auth
JWT_AUDIENCE=secure-user-auth.web

ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Seeds the demo account (ada@example.com) on `npm run seed`.
BOOTSTRAP_DEMO_USER=true

# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# SQLite database file. Created automatically, along with its parent directory.
DATABASE_FILE=./data/auth.sqlite

# REQUIRED IN PRODUCTION: at least 32 characters. The server refuses to boot without it
# when NODE_ENV=production. In development an ephemeral secret is generated at startup,
# which means tokens stop working across restarts — that is intentional.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=secure-user-auth
JWT_AUDIENCE=secure-user-auth.web

# Token lifetimes, in seconds.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Seeds the demo account (ada@example.com) on `npm run seed`.
BOOTSTRAP_DEMO_USER=true
